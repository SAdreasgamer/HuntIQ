# ============================================================
# HuntIQ — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME=HuntIQ
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
DB_TYPE=sqlite               # sqlite | postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=huntiq
DB_USER=huntiq
DB_PASSWORD=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_SQLITE_PATH=huntiq.db

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=10
REDIS_KEY_PREFIX=huntiq:

# ----------------------------------------------------------
# Apify (Job Scraping)
# ----------------------------------------------------------
APIFY_TOKEN=your_apify_token_here
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_DEFAULT_TIMEOUT=300
APIFY_MAX_RETRIES=3
APIFY_MEMORY_MBYTES=256

# ----------------------------------------------------------
# LLM Provider
# ----------------------------------------------------------
LLM_PROVIDER=openrouter      # openrouter | openai | ollama
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# LLM Fallback (optional)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# LLM Caching
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=604800         # 7 days in seconds

# LLM Rate Limiting
LLM_REQUESTS_PER_MINUTE=20

# LLM Quality Gate
LLM_MIN_SCORE_FOR_LLM=40

# ----------------------------------------------------------
# Search Configuration
# ----------------------------------------------------------
SEARCH_KEYWORDS=Backend Engineer,Software Engineer,Backend Software Engineer,Java Developer,Platform Engineer,SDE-1,Associate Software Engineer,Graduate Software Engineer,Microservices Engineer,Distributed Systems Engineer,Server Side Engineer
SEARCH_LOCATIONS=India,Remote,Singapore,Germany,Netherlands,Ireland,United Kingdom
SEARCH_EXCLUDED_KEYWORDS=Frontend,React,Angular,Flutter,Android,iOS,QA,Manual Testing,Prompt Engineer,Business Analyst,Support Engineer,SAP,Salesforce,ML Research,Data Scientist
SEARCH_FREQUENCY_HOURS=6
SEARCH_MAX_RESULTS_PER_PROVIDER=100
SEARCH_CONCURRENT_PROVIDERS=4
SEARCH_MAX_RETRIES=3
SEARCH_RETRY_BACKOFF_BASE=2.0

# ----------------------------------------------------------
# Matching Engine
# ----------------------------------------------------------
MATCH_NOTIFICATION_THRESHOLD=60
MATCH_LLM_THRESHOLD=40
MATCH_EMBEDDING_MODEL=all-MiniLM-L6-v2
MATCH_EMBEDDING_DIMENSIONS=384

# Scoring Weights (must sum to 1.0)
MATCH_WEIGHT_SKILLS=0.25
MATCH_WEIGHT_ROLE=0.20
MATCH_WEIGHT_EXPERIENCE=0.15
MATCH_WEIGHT_TECH_STACK=0.15
MATCH_WEIGHT_KEYWORDS=0.10
MATCH_WEIGHT_LOCATION=0.10
MATCH_WEIGHT_COMPANY_PREF=0.05

# Final Score Composition
MATCH_WEIGHT_RULE_SCORE=0.6
MATCH_WEIGHT_EMBEDDING_SCORE=0.4

# ----------------------------------------------------------
# Notifications
# ----------------------------------------------------------
NOTIFY_ENABLED=true

# Email
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_TO=your_email@example.com
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_USE_TLS=true

# Desktop
NOTIFY_DESKTOP_ENABLED=true

# Webhook
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# Rules
NOTIFY_MIN_SCORE=60
NOTIFY_NOTIFY_FAVORITES_ONLY=false
NOTIFY_MAX_AGE_HOURS=48

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
SECURITY_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-openssl-rand-hex-32
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=7
SECURITY_CORS_ORIGINS=http://localhost:8000,http://localhost:3000
SECURITY_RATE_LIMIT_PER_MINUTE=60
